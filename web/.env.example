# Copy to web/.env.local and fill in. Never commit .env.local, never put a secret in a NEXT_PUBLIC_ name.
# No keys are needed to play. The same four as README's "Run it for judging" table; leave a line empty to skip it.

# Sign-in, the account chip, server-saved takes, /progress from the server (web/src/data/config.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The server routes that save and read takes (web/src/data/server.ts). Server only.
SUPABASE_SECRET_KEY=

# The learning side's theory chat (web/src/app/learn/api/chat/route.ts). Server only.
ANTHROPIC_API_KEY=
